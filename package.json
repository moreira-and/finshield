{
  "name": "finshield",
  "version": "1.0.0",
  "description": "Implementação do https://www.tabnews.com.br para o https://curso.dev",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:up && npm run services:wait:database && npm run migrations:up && next dev",
    "test": "npm run services:up && concurrently -k -s command-jest --names next,jest --hide next \"next dev\" \"jest --runInBand --verbose\"",
    "posttest": "npm run services:stop",
    "test:watch": "jest --watchAll --runInBand --verbose",
    "services:up": "docker compose --env-file .env.development -f infra/compose.yaml up -d",
    "services:stop": "docker compose --env-file .env.development -f infra/compose.yaml stop",
    "services:down": "docker compose --env-file .env.development -f infra/compose.yaml down",
    "services:wait:database": "node infra/scripts/wait-for-postgres.js",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "next lint --dir .",
    "migrations:create": "node-pg-migrate --migrations-dir infra/migrations create",
    "migrations:up": "node-pg-migrate --migrations-dir infra/migrations --envPath .env.development up",
    "migrations:down": "node-pg-migrate --migrations-dir infra/migrations --envPath .env.development down",
    "prepare": "husky",
    "commit": "cz",
    "scan:staged": "gitleaks-secret-scanner",
    "scan:all": "gitleaks-secret-scanner --diff-mode all",
    "scan:history": "gitleaks-secret-scanner --diff-mode history",
    "check:updates": "npx npm-check-updates -i"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "async-retry": "1.3.3",
    "dotenv": "16.4.4",
    "dotenv-expand": "11.0.6",
    "next": "13.1.6",
    "next-connect": "1.0.0",
    "node-pg-migrate": "7.9.1",
    "pg": "8.18.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "swr": "2.2.5",
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "19.3.0",
    "@commitlint/config-conventional": "19.2.2",
    "commitizen": "4.3.1",
    "concurrently": "8.2.2",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.4",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-jest": "28.6.0",
    "gitleaks-secret-scanner": "2.1.1",
    "husky": "9.1.7",
    "jest": "29.6.2",
    "prettier": "3.8.1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
